{
  "name": "carolina-homekeeping",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --import tsx scripts/migrate-if-configured.ts && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "postgres": "^3.4.7",
    "stripe": "22.6.2",
    "zod": "^4.3.6",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0"
  }
}
